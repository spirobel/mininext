# dependencies and build output (tsc writes dist/, site/export.ts writes site/dist/)
node_modules/
dist/

# test runs write here, one folder per test file (tests/testdata.ts).
# each folder is cleaned when its test file starts, so you can look at it after a run.
/test-data/

# dev files that mininext build() writes next to a skeleton for bun's hmr
.mininext-*

# logs, env, editors, os
*.log
.env
.env.*
.idea/
.vscode-test/
.DS_Store
